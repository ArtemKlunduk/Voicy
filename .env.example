# ── Telegram API (обязательно, получить на https://my.telegram.org/apps) ──
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abc123def456

# ── OpenAI API (опционально, для улучшенного качества ответов) ──
# Если не указан — AI работает через бесплатный Pollinations AI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VoiceAPI (опционально, для качественной озвучки ElevenLabs) ──
# Если не указан — озвучка работает через бесплатный Windows SAPI
VOICE_API_KEY=xxxx:xxxxxxxxxxxxxxxxxxxxxxxxxx

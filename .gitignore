/target

# Runtime data (создаётся рядом с exe)
*.session
*.session-journal
voicy_dialogs.cache
voicy_capture.wav
voicy.toml
hotkey.json
contacts.txt

# Build artifacts
/dist
/build
*.spec
/installer/dist/
/handoff_extracted/

# Local maintainer secrets — embedded Telegram API creds for release builds.
# NEVER commit this directory.
/.creds/

# IDE/OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Installer build artifacts (бинари + готовые setup'ы — пересобираются упаковкой).
# voicy.toml в payload уже покрыт правилом «voicy.toml» выше (креды не коммитим).
/installer/Output/
/installer/payload/*.exe
/installer/payload/*.dll
/installer/payload/*.ico

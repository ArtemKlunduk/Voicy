# Voicy release build — embedded Telegram API credentials.
#
# Setup для maintainer'а:
#   1. В корне репо: mkdir .creds  (папка .creds/ в .gitignore)
#   2. Скопировать template:
#      cp scripts/build-credentials.env.example .creds/build-credentials.env
#   3. Заменить значения ниже на свои api_id/hash с my.telegram.org
#   4. Запустить scripts\build-release.cmd — credentials будут запечены в exe
#
# Юзеры скачают release zip → exe работает сразу без TELEGRAM_SETUP.md.
# Если кто-то хочет свои creds (advanced) — может вписать в voicy.toml,
# и они override наши embedded.
#
# Этот файл (.example) — публичный, в git с placeholder'ами.
# Реальные creds в .creds/build-credentials.env который гитнорится.

VOICY_BUILD_API_ID=12345678
VOICY_BUILD_API_HASH=your32characterhashfrommytelegramorg
